DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
POSTGRES_DB=phoebe
POSTGRES_USER=phoebe
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Ask Phoebe: leave the key empty unless you're testing real answers locally
# (then use a key from the Console's "Phoebe" workspace; never commit it).
ANTHROPIC_API_KEY=
# ASK_PHOEBE_MODEL=claude-opus-5-5
# ASK_PHOEBE_DAILY_BUDGET_USD=0.15

# Production only (set in the server's .env, not needed locally):
# DJANGO_HSTS_SECONDS=3600
# DJANGO_CSRF_TRUSTED_ORIGINS=https://phoebe-api.garickm.com
# DJANGO_ADMIN_PATH=some-random-string/
# DJANGO_CORS_ALLOWED_ORIGINS=https://phoebe.garickm.com
# SENTRY_DSN=  (the phoebe-api project's DSN; empty or unset = Sentry off)
