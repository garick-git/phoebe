{
  "about": "Ask Phoebe's evaluation set. run_ask_eval asks these for real (on the Mac, never in CI) and saves each reply in recordings/<model>.json; frontend/src/eval/ scores the recordings with verifyAnswer() on every PR. Pass times change daily, so each question checks behavior (tool, satellite, place, days) and faithfulness (every number verified against that reply's own tool results), not a fixed answer.",
  "gate_model": "claude-sonnet-5-5",
  "min_score": 19,
  "questions": [
    {
      "id": "iss-chicago-3d",
      "question": "When can I see the ISS from Chicago in the next 3 days?",
      "expect": { "type": "passes", "satellite": 25544, "place": { "asked": "Chicago", "label": ["Chicago", "Illinois"] }, "days": [3] }
    },
    {
      "id": "iss-austin-week",
      "question": "When can I see the ISS from Austin this week?",
      "expect": { "type": "passes", "satellite": 25544, "place": { "asked": "Austin", "label": ["Austin", "Texas"] }, "days": [7] }
    },
    {
      "id": "tiangong-london-tonight",
      "question": "Will Tiangong be visible from London tonight?",
      "expect": { "type": "passes", "satellite": 48274, "place": { "asked": "London", "label": ["London", "United Kingdom"] }, "days": [1, 2] }
    },
    {
      "id": "hubble-sydney-week",
      "question": "Can I see the Hubble Space Telescope from Sydney this week?",
      "expect": { "type": "passes", "satellite": 20580, "place": { "asked": "Sydney", "label": ["Sydney", "Australia"] }, "days": [7] }
    },
    {
      "id": "station-paris-2d",
      "question": "Is the space station going over Paris in the next 2 days?",
      "expect": { "type": "passes", "satellite": 25544, "place": { "asked": "Paris", "label": ["Paris", "France"] }, "days": [2] }
    },
    {
      "id": "iss-tokyo-next",
      "question": "When's the next time I can see the ISS from Tokyo?",
      "expect": { "type": "passes", "satellite": 25544, "place": { "asked": "Tokyo", "label": ["Tokyo", "Japan"] } }
    },
    {
      "id": "iss-denver-5d",
      "question": "ISS passes over Denver, Colorado for the next 5 days please",
      "expect": { "type": "passes", "satellite": 25544, "place": { "asked": "Denver", "label": ["Denver", "Colorado"] }, "days": [5] }
    },
    {
      "id": "css-toronto-week",
      "question": "I'm in Toronto. Any chance to spot the Chinese space station this week?",
      "expect": { "type": "passes", "satellite": 48274, "place": { "asked": "Toronto", "label": ["Toronto", "Canada"] }, "days": [7] }
    },
    {
      "id": "norad-seattle",
      "question": "When can I see satellite 25544 from Seattle?",
      "expect": { "type": "passes", "satellite": 25544, "place": { "asked": "Seattle", "label": ["Seattle", "Washington"] } }
    },
    {
      "id": "iss-mexico-city-4d",
      "question": "When should I look for the ISS from Mexico City over the next 4 days?",
      "expect": { "type": "passes", "satellite": 25544, "place": { "asked": "Mexico City", "label": ["Mexico City", "Mexico"] }, "days": [4] }
    },
    {
      "id": "iss-reykjavik-week",
      "question": "Can I see the ISS from Reykjavik this week?",
      "expect": { "type": "passes", "satellite": 25544, "place": { "asked": "Reykjavik", "label": ["Iceland"] }, "days": [7] }
    },
    {
      "id": "hubble-austin-3d",
      "question": "When does Hubble fly over Austin, Texas in the next 3 days?",
      "expect": { "type": "passes", "satellite": 20580, "place": { "asked": "Austin", "label": ["Austin", "Texas"] }, "days": [3] }
