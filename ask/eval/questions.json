    {
      "id": "clouds-tiangong-madrid-tonight",
      "question": "Is tonight a good night to see Tiangong from Madrid, or will it be too cloudy?",
      "expect": { "type": "passes", "satellite": 48274, "place": { "asked": "Madrid", "label": ["Madrid", "Spain"] }, "days": [1, 2], "clouds": true }
    },
    {
      "id": "fact-iss-altitude",
      "question": "How high is the ISS right now?",
